{
  "name": "bib-ordre",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "BiB Ordre — Order management for Blomster i Byhaven",
  "productName": "BiB Ordre",
  "author": {
    "name": "Andreas Henriksen",
    "email": "andreas@phenriksen.no"
  },
  "license": "UNLICENSED",
  "main": "dist/electron/main.js",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev:renderer": "vite --port 3000",
    "build:main": "tsc -p electron/tsconfig.json && node -e \"require('fs').mkdirSync('dist/electron',{recursive:true});require('fs').writeFileSync('dist/electron/package.json',JSON.stringify({type:'commonjs'}))\"",
    "dev": "concurrently -k -n vite,electron -c blue,green \"npm:dev:renderer\" \"wait-on http://localhost:3000 && npm run build:main && cross-env ELECTRON_DEV=1 electron dist/electron/main.js\"",
    "build": "vite build && npm run build:main",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "publish": "npm run build && electron-forge publish",
    "preview": "vite preview",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix",
    "postinstall": "electron-rebuild"
  },
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/raleway": "^5.2.8",
    "@fontsource-variable/victor-mono": "^5.2.8",
    "@react-pdf/renderer": "^4.3.2",
    "@storybook/react-vite": "^10.2.15",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/query-db-collection": "latest",
    "@tanstack/react-db": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-form-devtools": "^0.2.19",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-table": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "better-sqlite3": "^12.10.0",
    "bonjour-service": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "electron-store": "^11.0.2",
    "lucide-react": "^0.545.0",
    "pdf-to-printer": "^5.8.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.3.0",
    "storybook": "^10.2.15",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "update-electron-app": "^3.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/publisher-nucleus": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.3.1",
    "electron": "^33.2.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.1"
  }
}
