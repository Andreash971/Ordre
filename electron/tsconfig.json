{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "../dist/electron",
    // Root is the repo root so ../shared compiles alongside electron/.
    // Emit layout: dist/electron/electron/*.js + dist/electron/shared/*.js
    "rootDir": "..",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "../shared/**/*.ts"]
}
